# Public — safe for the browser bundle
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Used in emails (links back to the app). Defaults to localhost in dev.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only — used exclusively inside app/api/** route handlers.
# Never prefix this with NEXT_PUBLIC_ or import it into a client component.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Section 3: AI Property Valuation
OPENAI_API_KEY=your-openai-api-key
# Optional — defaults to gpt-4o if unset. Must be a model that supports
# structured outputs (response_format: json_schema, strict mode).
OPENAI_VALUATION_MODEL=gpt-4o

# Phase A (optional) — external scheduling link for video/phone booking.
# If set, shown after a consultation request (e.g. Calendly / Google Bookings).
NEXT_PUBLIC_SCHEDULING_URL=

# Phase B — Follow Up Boss (SOW 7)
# Create an API key in FUB Admin → API. Leave blank to skip CRM sync (logged as skipped).
FOLLOW_UP_BOSS_API_KEY=

# Phase B — Email via Resend (SOW 8)
RESEND_API_KEY=
# Verified sender, e.g. "Estate Valora <hello@yourdomain.com>"
EMAIL_FROM=Estate Valora <onboarding@resend.dev>
# Brokerage inbox for new-lead / consultation alerts
BROKERAGE_NOTIFY_EMAIL=

# Phase B — SMS via Twilio (SOW 8, optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Phase C — Admin dashboard (SOW 9) via Supabase Auth
# Bootstrap admin is created/updated automatically on /admin/login
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=change-me-min-6-chars
# Optional extra admins (comma-separated emails). Also anyone with app_metadata.role=admin.
ADMIN_EMAILS=
